{
  "functions": {
    "api/extract.js": {
      "maxDuration": 30
    },
    "api/media.js": {
      "maxDuration": 30
    },
    "api/instagram.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}