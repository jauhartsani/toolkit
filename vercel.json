{
  "functions": {
    "api/extract.js": {
      "maxDuration": 30
    },
    "api/media.js": {
      "maxDuration": 30
    },
    "api/instagram.py": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.toolkitme.my.id" }],
      "destination": "https://toolkitme.my.id/:path*",
      "permanent": true
    }
  ]
}
